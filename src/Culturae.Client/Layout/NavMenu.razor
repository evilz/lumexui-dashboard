@using Culturae.Client.Styles
@inject IStringLocalizer<SharedResource> L

@{
    var itemClass = NavMenuStyles.GetItemStyles(Collapsed, Class);
    var iconClass = NavMenuStyles.GetIconStyles();
    var labelClass = NavMenuStyles.GetLabelStyles();
}

<NavLink class="@itemClass" href="" Match="NavLinkMatch.All" title="@L["Nav_Home"]">
    <svg class="@iconClass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
    </svg>
    @if (!Collapsed)
    {
        <span class="@labelClass">@L["Nav_Home"]</span>
    }
</NavLink>

<NavLink class="@itemClass" href="investor-panel" title="@L["Nav_InvestorPanel"]">
    <svg class="@iconClass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
    </svg>
    @if (!Collapsed)
    {
        <span class="@labelClass">@L["Nav_InvestorPanel"]</span>
    }
</NavLink>

<NavLink class="@itemClass" href="open-projects" title="@L["Nav_OpenProjects"]">
    <svg class="@iconClass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
    </svg>
    @if (!Collapsed)
    {
        <span class="@labelClass">@L["Nav_OpenProjects"]</span>
    }
</NavLink>

<NavLink class="@itemClass" href="promoter-panel" title="@L["Nav_PromoterPanel"]">
    <svg class="@iconClass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
    </svg>
    @if (!Collapsed)
    {
        <span class="@labelClass">@L["Nav_PromoterPanel"]</span>
    }
</NavLink>

<NavLink class="@itemClass" href="settings" title="@L["Nav_Settings"]">
    <svg class="@iconClass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
    </svg>
    @if (!Collapsed)
    {
        <span class="@labelClass">@L["Nav_Settings"]</span>
    }
</NavLink>

<style>
    .active {
        background-color: rgb(var(--lumex-primary) / 0.1);
        color: rgb(var(--lumex-primary));
    }
</style>

@code {
    /// <summary>
    /// Additional CSS class to apply to nav items.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Indicates whether the navigation menu is collapsed.
    /// </summary>
    [Parameter]
    public bool Collapsed { get; set; } = false;
}
