@page "/investor-panel"
@inject IStringLocalizer<SharedResource> L

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-foreground">@L["Investor_Title"]</h1>
        <p class="text-default-500 mt-1">@L["Investor_Subtitle"]</p>
    </div>

    <!-- Portfolio Summary -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-5 rounded-xl border border-divider bg-content1">
            <p class="text-sm text-default-400">@L["Investor_TotalInvested"]</p>
            <p class="text-2xl font-bold text-foreground mt-1">€85,400</p>
            <p class="text-xs text-success mt-2">+12.5% @L["Investor_Return"]</p>
        </div>
        <div class="p-5 rounded-xl border border-divider bg-content1">
            <p class="text-sm text-default-400">@L["Investor_ActiveInvestments"]</p>
            <p class="text-2xl font-bold text-foreground mt-1">7</p>
            <p class="text-xs text-default-400 mt-2">@L["Investor_AcrossCategories"]</p>
        </div>
        <div class="p-5 rounded-xl border border-divider bg-content1">
            <p class="text-sm text-default-400">@L["Investor_PendingReturns"]</p>
            <p class="text-2xl font-bold text-foreground mt-1">€3,200</p>
            <p class="text-xs text-warning mt-2">@L["Investor_NextPayout"]</p>
        </div>
        <div class="p-5 rounded-xl border border-divider bg-content1">
            <p class="text-sm text-default-400">@L["Investor_Completed"]</p>
            <p class="text-2xl font-bold text-foreground mt-1">14</p>
            <p class="text-xs text-success mt-2">@L["Investor_AllSettled"]</p>
        </div>
    </div>

    <!-- Active Investments Table -->
    <div class="p-6 rounded-xl border border-divider bg-content1">
        <h2 class="text-lg font-semibold text-foreground mb-4">@L["Investor_YourInvestments"]</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-divider text-left">
                        <th class="pb-3 font-medium text-default-400">@L["Investor_Project"]</th>
                        <th class="pb-3 font-medium text-default-400">@L["Investor_Category"]</th>
                        <th class="pb-3 font-medium text-default-400">@L["Investor_Amount"]</th>
                        <th class="pb-3 font-medium text-default-400">@L["Investor_ReturnCol"]</th>
                        <th class="pb-3 font-medium text-default-400">@L["Investor_Status"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-divider">
                    @foreach (var investment in _investments)
                    {
                        <tr>
                            <td class="py-3 font-medium text-foreground">@investment.Project</td>
                            <td class="py-3 text-default-500">@investment.Category</td>
                            <td class="py-3 text-foreground">€@investment.Amount.ToString("N0")</td>
                            <td class="py-3 text-success">+@investment.ReturnPct%</td>
                            <td class="py-3">
                                <span class="px-2 py-1 text-xs font-medium rounded-full @GetStatusClass(investment.Status)">
                                    @investment.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Available Projects -->
    <div class="p-6 rounded-xl border border-divider bg-content1">
        <h2 class="text-lg font-semibold text-foreground mb-4">@L["Investor_AvailableProjects"]</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var project in _availableProjects)
            {
                <div class="p-4 rounded-lg border border-divider hover:border-primary transition-colors">
                    <h3 class="font-semibold text-foreground">@project.Name</h3>
                    <p class="text-sm text-default-400 mt-1">@project.Category</p>
                    <div class="flex items-center justify-between mt-3">
                        <span class="text-sm font-medium text-foreground">€@project.Goal.ToString("N0") @L["Investor_Goal"]</span>
                        <span class="text-sm text-primary">@project.FundedPct% @L["Investor_Funded"]</span>
                    </div>
                    <div class="w-full bg-default-100 rounded-full h-2 mt-2">
                        <div class="bg-primary h-2 rounded-full" style="width: @(project.FundedPct)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Investment> _investments = new()
    {
        new("Teatro Real Season 2025", "Performing Arts", 15000, 8.5m, "Active"),
        new("Flamenco World Tour", "Music", 10000, 12.0m, "Active"),
        new("Contemporary Art Fair", "Visual Arts", 25000, 6.2m, "Active"),
        new("Documentary Film Fund", "Cinema", 5000, 15.0m, "Pending"),
        new("Literary Festival Madrid", "Literature", 8000, 9.8m, "Active"),
    };

    private List<AvailableProject> _availableProjects = new()
    {
        new("Baroque Music Revival", "Music", 50000, 72),
        new("Street Art Barcelona", "Visual Arts", 30000, 45),
        new("Indie Film Showcase", "Cinema", 80000, 28),
    };

    private string GetStatusClass(string status) => status switch
    {
        "Active" => "bg-success/10 text-success",
        "Pending" => "bg-warning/10 text-warning",
        "Completed" => "bg-default-100 text-default-500",
        _ => "bg-default-100 text-default-500"
    };

    private record Investment(string Project, string Category, decimal Amount, decimal ReturnPct, string Status);
    private record AvailableProject(string Name, string Category, decimal Goal, int FundedPct);
}
