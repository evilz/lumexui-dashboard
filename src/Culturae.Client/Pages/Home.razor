@page "/"
@inject IStringLocalizer<SharedResource> L

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-foreground">@L["Home_Welcome"]</h1>
        <p class="text-default-500 mt-1">@L["Home_Subtitle"]</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-xl border border-divider bg-content1">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 rounded-lg bg-primary/10">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-foreground">@L["Home_ActiveProjects"]</h2>
            </div>
            <p class="text-3xl font-bold text-foreground">12</p>
            <p class="text-sm text-success mt-1">@L["Home_ThisMonth"]</p>
        </div>

        <div class="p-6 rounded-xl border border-divider bg-content1">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 rounded-lg bg-success/10">
                    <svg class="w-6 h-6 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-foreground">@L["Home_TotalInvested"]</h2>
            </div>
            <p class="text-3xl font-bold text-foreground">€1.2M</p>
            <p class="text-sm text-success mt-1">@L["Home_VsLastQuarter"]</p>
        </div>

        <div class="p-6 rounded-xl border border-divider bg-content1">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 rounded-lg bg-warning/10">
                    <svg class="w-6 h-6 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-foreground">@L["Home_Participants"]</h2>
            </div>
            <p class="text-3xl font-bold text-foreground">248</p>
            <p class="text-sm text-default-400 mt-1">@L["Home_InvestorsPromoters"]</p>
        </div>
    </div>

    <div class="p-6 rounded-xl border border-divider bg-content1">
        <h2 class="text-lg font-semibold text-foreground mb-4">@L["Home_RecentActivity"]</h2>
        <div class="space-y-4">
            <div class="flex items-center justify-between py-3 border-b border-divider">
                <div>
                    <p class="font-medium text-foreground">@L["Home_NewInvestment"]</p>
                    <p class="text-sm text-default-400">@L["Home_TwoHoursAgo"]</p>
                </div>
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-success/10 text-success">@L["Home_Investment"]</span>
            </div>
            <div class="flex items-center justify-between py-3 border-b border-divider">
                <div>
                    <p class="font-medium text-foreground">@L["Home_ProjectPublished"]</p>
                    <p class="text-sm text-default-400">@L["Home_FiveHoursAgo"]</p>
                </div>
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-primary/10 text-primary">@L["Home_Project"]</span>
            </div>
            <div class="flex items-center justify-between py-3">
                <div>
                    <p class="font-medium text-foreground">@L["Home_PayoutCompleted"]</p>
                    <p class="text-sm text-default-400">@L["Home_OneDayAgo"]</p>
                </div>
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-warning/10 text-warning">@L["Home_Payout"]</span>
            </div>
        </div>
    </div>
</div>
